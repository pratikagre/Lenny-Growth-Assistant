# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration
# ==============================================================================

# Application Port & Host
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Persistence Configuration (PostgreSQL / SQLite Fallback)
# ------------------------------------------------------------------------------
# Default Docker Compose PostgreSQL with pgvector:
DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/lenny_assistant

# Zero-dependency local evaluation fallback (uncomment to use local SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./lenny_assistant.db

# ------------------------------------------------------------------------------
# LLM Providers Configuration
# ------------------------------------------------------------------------------
# Default provider to use: 'ollama', 'claude', 'openai', or 'mock'
DEFAULT_LLM_PROVIDER=ollama

# Local Ollama Configuration (Mandatory for Local Evaluation Demo)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Optional fallback model if 3b is not pulled:
# OLLAMA_MODEL=llama3.1:8b

# Cloud Provider API Keys (Optional - only required if switching to Cloud)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# CORS & Security
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
